# Environment Configuration
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./platform5.db
# For PostgreSQL: postgresql://user:password@localhost/cenai_db

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=development-secret-key-change-in-production-must-be-very-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=development-encryption-key-32chars

# API Settings
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5100"]

# AI Provider API Keys (Optional)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Local AI Servers
LM_STUDIO_URL=http://localhost:1234
OLLAMA_URL=http://localhost:11434

# Redis (for caching and Celery - Optional)
REDIS_URL=redis://localhost:6379/0

# Celery (for background tasks - Optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cenai.log

# Cost Tracking
DEFAULT_BUDGET_LIMIT=100.00
BUDGET_ALERT_THRESHOLD=0.8